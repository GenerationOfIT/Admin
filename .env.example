# Same Supabase project as the GenofIT site. Admins sign in with their own
# Supabase Auth account; every read and write uses that session, so RLS
# (is_admin()) decides access. No secret keys belong in this app.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# The public GenofIT site, for previews of images stored there
# (e.g. http://localhost:3000 locally). Not a secret.
NEXT_PUBLIC_SITE_URL=
